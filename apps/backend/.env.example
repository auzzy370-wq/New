# =============================================================
# TapFlow POS Backend - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# =============================================================

# Application
NODE_ENV=development
PORT=3001

# =============================================================
# DATABASE
# =============================================================
# PostgreSQL connection string
DATABASE_URL="postgresql://tapflow:tapflow_dev_password@localhost:5432/tapflow_db?schema=public"

# =============================================================
# REDIS
# =============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tapflow_redis_password

# =============================================================
# JWT SECRETS
# IMPORTANT: Generate strong random secrets for production.
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRATION=30d

# =============================================================
# STRIPE
# IMPORTANT: Use test keys for development, live keys for production.
# Keys from: https://dashboard.stripe.com/apikeys
# NEVER put secret keys in mobile apps.
# =============================================================

# Stripe Secret Key (server-side only — NEVER expose to clients)
# Test: sk_test_...
# Live: sk_live_...
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# Stripe Webhook Signing Secret
# Create at: https://dashboard.stripe.com/webhooks
# For local development, use: stripe listen --forward-to localhost:3001/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Stripe Subscription Price ID
# Create a product + recurring price at: https://dashboard.stripe.com/products
# Price should be: $25.00/month USD
STRIPE_SUBSCRIPTION_PRICE_ID=price_REPLACE_WITH_YOUR_SUBSCRIPTION_PRICE_ID

# Platform fee rate (1% = 0.01)
STRIPE_PLATFORM_FEE_RATE=0.01

# =============================================================
# APPLICATION URLS
# =============================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================
# EMAIL (SMTP)
# Development: Uses MailHog (see docker-compose.yml)
# Production: Use a real SMTP service (SendGrid, Mailgun, etc.)
# =============================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@tapflow.app

# =============================================================
# OBJECT STORAGE (MinIO / S3)
# Development: Uses local MinIO (see docker-compose.yml)
# Production: Use AWS S3 or compatible service
# =============================================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=tapflow_minio
STORAGE_SECRET_KEY=tapflow_minio_password
STORAGE_BUCKET=tapflow
STORAGE_REGION=us-east-1

# =============================================================
# ADMIN ACCESS
# Used for the platform admin dashboard
# =============================================================
ADMIN_EMAIL=admin@tapflow.app
ADMIN_SECRET=REPLACE_WITH_STRONG_ADMIN_SECRET
